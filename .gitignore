# ---- Universal -----------------------------------------------------------
# Secrets: belt and braces. The hooks scan for leaked credentials, but the
# cheapest leak to prevent is the file git never tracked in the first place.
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/**/*.key
*.p12
*.pfx
id_rsa
id_ed25519
*.kdbx
secrets.y*ml
!secrets.example.y*ml
credentials.json
service-account*.json

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.fleet/

# Logs and scratch
*.log
tmp/
.tmp/
.cache/

# ---- Docs ----------------------------------------------------------------
_site/
.docusaurus/
site/

# ---- .NET ----------------------------------------------------------------
# Build output is never committed - releases are built and checksummed by CI.
bin/
obj/
artifacts/
*.user
*.suo
.vs/
TestResults/
*.nupkg
# LaunchBox's own assemblies are referenced from a local install, never vendored.
Unbroken.LaunchBox.Plugins.dll

# Local copy of LaunchBox's plugin API for building the plugin shell (never committed).
.launchbox-ref/
